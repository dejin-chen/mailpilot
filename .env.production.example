# MailPilot 单机生产部署示例
# 复制为 .env.production 后替换所有 CHANGE_ME；不要提交真实文件。

APP_NAME=MailPilot
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=[]

MAILPILOT_IMAGE_TAG=0.1.0
INTERNAL_BIND_ADDRESS=127.0.0.1
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_PORT=80

POSTGRES_USER=mailpilot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=mailpilot
POSTGRES_PORT=5432
DOCKER_DATABASE_URL=postgresql+psycopg://mailpilot:CHANGE_ME_URL_ENCODED_POSTGRES_PASSWORD@postgres:5432/mailpilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
AGENT_STORE_TIMEOUT_SECONDS=10

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
DOCKER_REDIS_URL=redis://:CHANGE_ME_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_KEY_PREFIX=mailpilot
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
WRITE_LOCK_TTL_SECONDS=30

JWT_SECRET_KEY=CHANGE_ME_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=mailpilot
JWT_AUDIENCE=mailpilot-api

MCP_INTERNAL_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_CHARACTERS
MAIL_MCP_URL=http://mail-mcp:8001/mcp
CALENDAR_MCP_URL=http://calendar-mcp:8002/mcp
MCP_TIMEOUT_SECONDS=10
MCP_MAX_RETRIES=1

DOCKER_MAILPILOT_API_URL=http://backend:8000/api/v1

LLM_API_KEY=CHANGE_ME_MODEL_API_KEY
LLM_BASE_URL=https://your-openai-compatible-provider.example.com/v1
LLM_MODEL_NAME=CHANGE_ME_MODEL_NAME
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
AGENT_ANALYSIS_MODE=optimized

LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=false
