# ========================================
# MailPilot 本地开发环境变量示例
# 复制为 .env 后再使用；不要提交真实密钥。
# ========================================

# 应用
APP_NAME=MailPilot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501"]
BACKEND_PORT=8000
FRONTEND_PORT=8501
INTERNAL_BIND_ADDRESS=127.0.0.1
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
MAILPILOT_IMAGE_TAG=local
MAILPILOT_API_URL=http://localhost:8000/api/v1
DOCKER_MAILPILOT_API_URL=http://backend:8000/api/v1

# PostgreSQL
POSTGRES_USER=mailpilot
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_DB=mailpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mailpilot:replace_with_local_postgres_password@localhost:5432/mailpilot
DOCKER_DATABASE_URL=postgresql+psycopg://mailpilot:replace_with_local_postgres_password@postgres:5432/mailpilot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
AGENT_STORE_TIMEOUT_SECONDS=10

# Redis
REDIS_PASSWORD=replace_with_local_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:replace_with_local_redis_password@localhost:6379/0
DOCKER_REDIS_URL=redis://:replace_with_local_redis_password@redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_KEY_PREFIX=mailpilot
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
WRITE_LOCK_TTL_SECONDS=30

# JWT（第 2 阶段启用最小认证骨架）
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=mailpilot
JWT_AUDIENCE=mailpilot-api

# 本地演示数据（只在手动执行 seed_demo.py 时使用）
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# OpenAI Compatible 模型（第 4 阶段启用）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# MCP 内部服务认证（第 3 阶段启用）
MCP_INTERNAL_TOKEN=replace_with_internal_service_token
MAIL_MCP_URL=http://mail-mcp:8001/mcp
CALENDAR_MCP_URL=http://calendar-mcp:8002/mcp
MAIL_MCP_PORT=8001
CALENDAR_MCP_PORT=8002
MCP_TIMEOUT_SECONDS=10
MCP_MAX_RETRIES=1

# Langfuse（可选启用，留空或关闭时不影响核心功能）
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=false

# DeepEval 默认评测不联网；关闭匿名遥测，真实裁判模型需显式使用评测命令
DEEPEVAL_TELEMETRY_OPT_OUT=1
